<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Car Racing</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#101820;color:white;font-family:Arial;text-align:center}
h2{margin:12px}
#game{position:relative;width:min(100vw,400px);height:65vh;min-height:380px;max-height:620px;margin:auto;overflow:hidden;background:#333;border-left:6px solid #777;border-right:6px solid #777}
#road{position:absolute;inset:0;background:#353535}
.line{position:absolute;left:49%;width:4px;height:65px;background:#fff;animation:road 0.7s linear infinite}
@keyframes road{from{transform:translateY(-80px)}to{transform:translateY(700px)}}
.car{position:absolute;width:42px;height:68px;border-radius:10px 10px 5px 5px;border:3px solid #eee;box-shadow:inset 0 10px #ffaaaa;z-index:2}
#player{bottom:18px;left:calc(50% - 21px);background:#e53935}
.enemy{background:#168cff;top:-80px}
#score{font-size:20px;margin:8px}
.controls{display:flex;justify-content:center;gap:24px;margin:12px}
button{font-size:22px;padding:12px 28px;border:0;border-radius:12px;background:#ffc107;color:#111;font-weight:bold}
#start{font-size:17px;padding:10px 22px}
</style>
</head>
<body>
<h2>🏎️ Car Racing</h2>
<div id="score">Score: 0</div>
<div id="game">
 <div id="road"></div>
 <div id="player" class="car"></div>
</div>
<div class="controls">
 <button id="left">⬅️</button>
 <button id="right">➡️</button>
</div>
<button id="start">Start Game</button>
<p>Traffic se bacho aur apna score badhao!</p>
<script>
const game=document.getElementById('game');
const player=document.getElementById('player');
const road=document.getElementById('road');
const scoreBox=document.getElementById('score');
let x=0,score=0,running=false,enemyList=[],timer;
function reset(){
 clearInterval(timer);
 enemyList.forEach(e=>e.el.remove());
 enemyList=[];
 road.innerHTML='';
 x=(game.clientWidth-42)/2;
 player.style.left=x+'px';
 score=0;
 scoreBox.textContent='Score: 0';
}
function move(dx){
 if(!running)return;
 x=Math.max(0,Math.min(game.clientWidth-42,x+dx));
 player.style.left=x+'px';
}
document.getElementById('left').onpointerdown=()=>move(-28);
document.getElementById('right').onpointerdown=()=>move(28);
document.onkeydown=e=>{
 if(e.key==='ArrowLeft')move(-28);
 if(e.key==='ArrowRight')move(28);
};
function endGame(){
 running=false;
 clearInterval(timer);
 alert('Game Over! Your score: '+score);
}
function tick(){
 if(!running)return;
 if(Math.random()<0.035){
  const el=document.createElement('div');
  el.className='car enemy';
  const ex=Math.random()*(game.clientWidth-42);
  el.style.left=ex+'px';
  game.appendChild(el);
  enemyList.push({el,y:-75,x:ex});
 }
 enemyList.forEach(e=>{
  e.y+=5+score*0.025;
  e.el.style.top=e.y+'px';
  if(e.y>game.clientHeight)e.dead=true;
  if(e.y+60>game.clientHeight-90&&e.y<game.clientHeight-18&&Math.abs(e.x-x)<36)endGame();
 });
 enemyList=enemyList.filter(e=>{
  if(e.dead){e.el.remove();score++;scoreBox.textContent='Score: '+score;return false}
  return true;
 });
}
document.getElementById('start').onclick=()=>{
 reset();running=true;
 timer=setInterval(tick,30);
};
reset();
</script>
</body>
</html>